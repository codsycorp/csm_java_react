# PROFILE: Linux server production ~8GB RAM, 4 CPU
#
# Text worker (mặc định): qwen2.5-coder-3b-instruct-q4_k_m.gguf (~2GB RAM)
# Launch Go: ./backend-go/run-go-server.sh  (CSM_LOCAL_PROFILE=8gb)
# Model: ./scripts/download-ai-local-models.sh 8gb-3b
# Máy RAM rất chật: ./scripts/download-ai-local-models.sh 8gb (1.5B Q8_0) và đổi path bên dưới
# Chất lượng cao hơn (cần RAM dư ~5GB): ./scripts/download-ai-local-models.sh 8gb-7b
#   rồi đổi AI_LOCAL_LLAMA_MODEL_PATH → qwen2.5-coder-7b-instruct-q4_k_m.gguf

if [ -n "${BASH_SOURCE[0]:-}" ]; then
    _CSM_CONFIG_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    if [ -f "$_CSM_CONFIG_DIR/config.env" ]; then
        # shellcheck source=/dev/null
        source "$_CSM_CONFIG_DIR/config.env"
    fi
    unset _CSM_CONFIG_DIR
fi

CSM_LOCAL_PROFILE=8gb
SPRING_PROFILES_ACTIVE_OVERRIDE=prod,local-8gb
AI_LOCAL_MODE=8gb
AI_LOCAL_RUNTIME_TIER=balanced-8gb
# Muốn không bị clamp 14k/768 tok: thêm vào config.env → AI_LOCAL_PROMPT_BUDGET_DISABLED=true

# JVM (~1.25GB heap + ~1.6GB native 1.5B Q8 + OS) — Go backend ~3–4GB RSS khi model đã load
HEAP_SIZE=1280m
HEAP_INIT=256m
DIRECT_MEMORY_SIZE=128m
TOMCAT_MAX_THREADS=24
TOMCAT_MAX_CONNECTIONS=120
ENABLE_ALWAYS_PRETOUCH=false

AI_LOCAL_ONLY_ENABLED=true
AI_PROVIDER_FORCE_GEMINI=false
AI_ROUTER_SCORE_V2_MENU_JSON_CLOUD=false

AI_LOCAL_LLAMA_MODEL_PATH=./csm_datas/ai_local/model/qwen2.5-coder-3b-instruct-q4_k_m.gguf
AI_LOCAL_LLAMA_SEO_MODEL_PATH=./csm_datas/ai_local/model/qwen2.5-coder-3b-instruct-q4_k_m.gguf
AI_LOCAL_LLAMA_SWAP_MODELS=false

AI_LOCAL_LLAMA_RUNTIME_PROFILE=balanced
# ctx 8192 (mặc định) hoặc 12288 khi bật AI_LOCAL_PROMPT_BUDGET_DISABLED (overlay max-8gb)
AI_LOCAL_LLAMA_CONTEXT_WINDOW=8192
AI_LOCAL_LLAMA_CONTEXT_WINDOW_AUTO_FIT=true
AI_LOCAL_LLAMA_CONTEXT_WINDOW_HARD_CAP=8192
AI_LOCAL_LLAMA_MAX_TOKENS=2048
AI_LOCAL_LLAMA_MAX_PROMPT_CHARS=28000
AI_LOCAL_LLAMA_THREADS=3
# batch=512: prompt prefill must fit n_batch (64 caused GGML_ASSERT crash → ERR_HTTP2_PROTOCOL_ERROR on SSE)
AI_LOCAL_LLAMA_BATCH_SIZE=512
AI_LOCAL_LLAMA_UBATCH_SIZE=32
AI_LOCAL_LLAMA_MAX_CONCURRENT_REQUESTS=1
AI_LOCAL_LLAMA_PRELOAD_ON_STARTUP=true
AI_LOCAL_LLAMA_FORCE_SINGLE_THREAD_ON_WEAK=false
AI_LOCAL_LLAMA_NATIVE_SKIP_WARMUP=true
AI_LOCAL_LLAMA_NATIVE_DISABLE_FIT=false
AI_LOCAL_LLAMA_UNLOAD_AFTER_IDLE_MS=120000
AI_LOCAL_LLAMA_GPU_LAYERS=0
AI_LOCAL_LLAMA_USE_MMAP=true
AI_LOCAL_LLAMA_USE_MLOCK=false
AI_LOCAL_LLAMA_INTER_REQUEST_COOLDOWN_MS=900
# Go: llama.cpp in-process (same as Java de.kherud.llama JNI)
AI_LOCAL_LLAMA_NATIVE_ENABLED=true

# Go/Rust — SSD eq-index + low RAM Pebble (AI model ~4.5GB gets priority)
CSM_EQ_INDEX_MODE=pebble
CSM_EQ_INDEX_ROOT=./csm_datas/native/eq_index
CSM_PEBBLE_CACHE_MB=32
CSM_PEBBLE_MEMTABLE_MB=8
CSM_PEBBLE_INDEX_MEMTABLE_MB=4
CSM_VECTOR_RECORDS_ENABLED=false
CSM_STARTUP_REINDEX=true
# Auth + SSR (sys_autos) + routing; rebuild eq-index from Pebble when indexed_keys < rows
CSM_STARTUP_REINDEX_TABLES=csm/csm_accounts,csm/csm_group_members,csm/sys_autos,csm/sys_la_routers

AI_SEO_ARTICLE_MAX_TOKENS=2048
AI_SEO_LOCALE_TRANSLATE_MAX_TOKENS=1024
AI_EMBEDDING_PROVIDER=hash
AI_EMBEDDING_LLAMA_ENABLED=false
AI_EMBEDDING_HASH_DIMENSIONS=128
AI_EMBEDDING_HASH_FALLBACK_ENABLED=true

AI_LOCAL_PROMPT_SLOT_ACTIVE_EDITOR_CHARS=12000
AI_LOCAL_PROMPT_SLOT_RAG_CONTEXT_CHARS=3000
AI_CODE_STREAM_LOCAL_PROVIDER_MAX_PROMPT_CHARS=24000
AI_CODE_STREAM_MAX_PROMPT_CHARS=28000
# Print trigger / code patch cần return HTML dài
AI_CODE_STREAM_EDIT_MAX_TOKENS=4096
AI_CODE_STREAM_PRINT_IMPORT_MAX_TOKENS=6144

# Learning memory — Pebble SSD (_csm/ai_learning), không giữ trong RAM
AI_LOCAL_LEARNING_STORE=pebble
AI_LOCAL_LEARNING_MIGRATE_JSONL=true
AI_MENU_LEARNING_ENABLED=true
AI_CODE_LEARNING_ENABLED=true
AI_MENU_LEARNING_MAX_ENTRIES=240
AI_CODE_LEARNING_MAX_ENTRIES=240

# Plan-then-execute (slice nhỏ trên 8GB — vẫn merge tích lũy)
AI_LOCAL_INCREMENTAL_PLAN_ENABLED=true
AI_LOCAL_INCREMENTAL_PLAN_MAX_STEPS=5
AI_LOCAL_EDIT_TASK_PLANNER_ENABLED=true
AI_LOCAL_EDIT_TASK_PLANNER_MAX_SLICES=4
AI_LOCAL_EDIT_TASK_PLANNER_SLICE_MAX_CHARS=9000
# Map-reduce analyze (large code on 8GB — chunk then synthesize)
AI_LOCAL_ANALYZE_MAP_REDUCE_MIN_CODE_CHARS=12000
AI_LOCAL_RUNTIME_WEAK_PROFILE_MAP_REDUCE_MAX_CHUNKS=5
AI_LOCAL_RUNTIME_WEAK_PROFILE_MAP_REDUCE_CHUNK_CHARS=9000

# SEO lane — VI-first + locale translate (auto-lmkt.js one-shot)
AI_SEO_ARTICLE_MAX_TOKENS=2048
AI_SEO_LOCALE_TRANSLATE_MAX_TOKENS=1024
AI_SEO_MAX_PROMPT_CHARS=48000
AI_SEO_REQUEST_TIMEOUT_MS=0
AI_SEO_LOCALE_TRANSLATE_MAX_SOURCE_CHARS=12000
AI_SEO_LOCALE_TRANSLATE_MAX_SOURCE_CHARS=900
AI_SEO_LOCALE_TRANSLATE_FALLBACK_ON_INCOMPLETE=true
AI_SEO_PIPELINE_ARTICLE_RETRY_ENABLED=true

AI_ORCHESTRATION_MULTIMODAL_SCOPE_RAG_TOP_K=5
AI_ORCHESTRATION_MULTIMODAL_SCOPE_RAG_MAX_CHARS=5000

AI_ORCHESTRATION_MULTIMODAL_VISION_ENABLED=false
AI_MEDIA_RENDER_ENABLED=false

# ── Platform engineering (observability / security / governance) ──
CSM_STRUCTURED_LOGS=true
CSM_METRICS_ENABLED=true
CSM_METRICS_PATH=/metrics
CSM_SERVICE_NAME=csm-go
CSM_AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_MAX=120
CSM_AUDIT_ENABLED=true
CSM_AUDIT_RETENTION_DAYS=90
AI_EMBEDDING_PROVIDER=auto
CSM_LLAMA_BREAKER_FAILURES=5
CSM_LLAMA_BREAKER_COOLDOWN_MS=30000
CSM_SHUTDOWN_TIMEOUT_MS=15000
# Production: set CSM_CORS_ALLOWED_ORIGINS=https://admin.csmbridge.net,https://api.csmbridge.net
# Production: CSM_ENV=production CSM_REQUIRE_STRONG_JWT=1
# Phase 2 — OpenTelemetry (local collector: deploy/observability docker compose otel-collector)
# CSM_OTEL_ENABLED=true
# CSM_OTEL_ENDPOINT=localhost:4318
# CSM_OTEL_INSECURE=true
# Phase 2 — Redis event bus (multi-instance / horizontal scale)
# CSM_EVENT_BUS=redis
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
AI_MEDIA_CHARACTER_ENABLED=false

AI_GUEST_CHAT_MAX_CONCURRENT=1
AI_GUEST_CHAT_MAX_OUTPUT_TOKENS=128
AI_GUEST_CHAT_PER_GUEST_COOLDOWN_MS=45000
AI_GUEST_CHAT_SKIP_WHEN_WORKER_BUSY=true
AI_GUEST_CHAT_MIN_FREE_HEAP_MB=320

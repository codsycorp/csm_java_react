# PROFILE: Linux server production ~8GB RAM, 4 CPU
#
# Text worker: qwen2.5-coder-7b-instruct-q4_k_m.gguf (~4.5GB RAM)
# Launch: ./run-server.sh
# Model: ./scripts/download-ai-local-models.sh 8gb

if [ -n "${BASH_SOURCE[0]:-}" ]; then
    _CSM_CONFIG_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    if [ -f "$_CSM_CONFIG_DIR/config.env" ]; then
        # shellcheck source=/dev/null
        source "$_CSM_CONFIG_DIR/config.env"
    fi
    unset _CSM_CONFIG_DIR
fi

CSM_LOCAL_PROFILE=8gb
SPRING_PROFILES_ACTIVE_OVERRIDE=prod,local-8gb
AI_LOCAL_MODE=8gb
AI_LOCAL_RUNTIME_TIER=balanced-8gb

# JVM (~1.25GB heap + ~4.5GB native 7B Q4 + OS) — RSS java thường ~6–7GB khi model đã load
HEAP_SIZE=1280m
HEAP_INIT=256m
DIRECT_MEMORY_SIZE=128m
TOMCAT_MAX_THREADS=24
TOMCAT_MAX_CONNECTIONS=120
ENABLE_ALWAYS_PRETOUCH=false

AI_LOCAL_ONLY_ENABLED=true
AI_PROVIDER_FORCE_GEMINI=false
AI_ROUTER_SCORE_V2_MENU_JSON_CLOUD=false

AI_LOCAL_LLAMA_MODEL_PATH=./csm_datas/ai_local/model/qwen2.5-coder-7b-instruct-q4_k_m.gguf
AI_LOCAL_LLAMA_SEO_MODEL_PATH=./csm_datas/ai_local/model/qwen2.5-coder-7b-instruct-q4_k_m.gguf
AI_LOCAL_LLAMA_SWAP_MODELS=false

AI_LOCAL_LLAMA_RUNTIME_PROFILE=balanced
AI_LOCAL_LLAMA_CONTEXT_WINDOW=8192
AI_LOCAL_LLAMA_CONTEXT_WINDOW_AUTO_FIT=true
AI_LOCAL_LLAMA_CONTEXT_WINDOW_HARD_CAP=8192
AI_LOCAL_LLAMA_MAX_TOKENS=1024
AI_LOCAL_LLAMA_MAX_PROMPT_CHARS=32000
AI_LOCAL_LLAMA_THREADS=3
AI_LOCAL_LLAMA_BATCH_SIZE=64
AI_LOCAL_LLAMA_UBATCH_SIZE=32
AI_LOCAL_LLAMA_MAX_CONCURRENT_REQUESTS=1
AI_LOCAL_LLAMA_PRELOAD_ON_STARTUP=false
AI_LOCAL_LLAMA_FORCE_SINGLE_THREAD_ON_WEAK=false
AI_LOCAL_LLAMA_NATIVE_SKIP_WARMUP=true
AI_LOCAL_LLAMA_NATIVE_DISABLE_FIT=false
AI_LOCAL_LLAMA_UNLOAD_AFTER_IDLE_MS=120000
AI_LOCAL_LLAMA_GPU_LAYERS=0
AI_LOCAL_LLAMA_INTER_REQUEST_COOLDOWN_MS=900

AI_SEO_ARTICLE_MAX_TOKENS=2048
AI_SEO_LOCALE_TRANSLATE_MAX_TOKENS=1024
AI_EMBEDDING_PROVIDER=hash
AI_EMBEDDING_LLAMA_ENABLED=false
AI_EMBEDDING_HASH_DIMENSIONS=128
AI_EMBEDDING_HASH_FALLBACK_ENABLED=true

AI_LOCAL_PROMPT_SLOT_ACTIVE_EDITOR_CHARS=22000
AI_LOCAL_PROMPT_SLOT_RAG_CONTEXT_CHARS=5000
AI_CODE_STREAM_LOCAL_PROVIDER_MAX_PROMPT_CHARS=48000
AI_CODE_STREAM_MAX_PROMPT_CHARS=52000

AI_ORCHESTRATION_MULTIMODAL_SCOPE_RAG_TOP_K=5
AI_ORCHESTRATION_MULTIMODAL_SCOPE_RAG_MAX_CHARS=5000

AI_ORCHESTRATION_MULTIMODAL_VISION_ENABLED=false
AI_MEDIA_RENDER_ENABLED=false
AI_MEDIA_CHARACTER_ENABLED=false

AI_GUEST_CHAT_MAX_CONCURRENT=1
AI_GUEST_CHAT_MAX_OUTPUT_TOKENS=128
AI_GUEST_CHAT_PER_GUEST_COOLDOWN_MS=45000
AI_GUEST_CHAT_SKIP_WHEN_WORKER_BUSY=true
AI_GUEST_CHAT_MIN_FREE_HEAP_MB=320

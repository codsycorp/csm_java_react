# Production — /root/la_server (copy → config.env)
# Paths relative to CSM_HOME=/root/la_server

CSM_HOME=/root/la_server
CSM_LOCAL_PROFILE=8gb

SERVER_PORT=9999
SOCKET_SERVER_PORT=15301

APP_DATA_DIR=./csm_datas
CSM_NATIVE_DATA_DIR=./csm_datas/native
CSM_PEBBLE_ROOT=./csm_datas/native/pebble
CSM_VECTOR_DIR=./csm_datas/native/vector/qdrant
CSM_KV_BACKUP_DIR=./csm_datas/backups
LUCENE_INDEX_ROOT_DIR=./csm_datas/lucene_index

CSM_STARTUP_REINDEX=true
CSM_STARTUP_REINDEX_TABLES=csm/csm_accounts,csm/csm_group_members,csm/sys_autos,csm/sys_la_routers
# 8gb profile: pebble eq-index on SSD (same as Go)
CSM_EQ_INDEX_MODE=pebble
CSM_VECTOR_RECORDS_ENABLED=false

JWT_SECRET=change-me-to-match-production
RUST_LOG=info

REDIS_ENABLED=0
AI_LOCAL_LLAMA_NATIVE_ENABLED=true
AI_LOCAL_LLAMA_GPU_LAYERS=0
AI_LOCAL_LLAMA_PRELOAD_ON_STARTUP=false

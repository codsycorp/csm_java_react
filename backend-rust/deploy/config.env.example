# CSM Rust — copy to config.env on server (Linux / Windows)
# Paths relative to CSM_HOME (folder containing csm_rust_server / csm_server.exe)

SERVER_PORT=9999
SOCKET_SERVER_PORT=15301

CSM_KV_ENGINE=pebble
APP_DATA_DIR=./csm_datas
CSM_NATIVE_DATA_DIR=./csm_datas/native
CSM_PEBBLE_ROOT=./csm_datas/native/pebble
CSM_VECTOR_DIR=./csm_datas/native/vector/qdrant
CSM_KV_BACKUP_DIR=./csm_datas/backups
LUCENE_INDEX_ROOT_DIR=./csm_datas/lucene_index

CSM_STARTUP_REINDEX=true
CSM_STARTUP_REINDEX_TABLES=csm/csm_accounts,csm/csm_group_members,csm/sys_autos

JWT_SECRET=change-me-to-a-strong-secret
RUST_LOG=info

# Linux AI local (build linux package with local-ai):
# AI_LOCAL_LLAMA_NATIVE_ENABLED=true
# AI_LOCAL_LLAMA_MODEL_PATH=./csm_datas/ai_local/model/qwen2.5-coder-3b-instruct-q4_k_m.gguf

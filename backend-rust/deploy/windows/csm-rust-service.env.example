# CSM Rust Windows Service — copy thanh config.env o thu muc goc repo
# File nay chi la tai lieu tham khao; runtime doc config.env (xem load-service-env.bat)

# --- Service identity (NSSM) ---
# SERVICE_NAME=CSM_Rust_Service
# SERVICE_DISPLAY=CSM Rust Backend

# --- Ports (nginx backend_pool -> SERVER_PORT) ---
SERVER_PORT=9999
SOCKET_SERVER_PORT=15301

# --- Data paths (relative to CSM_HOME — cung cap voi csm_server.exe) ---
APP_DATA_DIR=./csm_datas
CSM_NATIVE_DATA_DIR=./csm_datas/native
CSM_PEBBLE_ROOT=./csm_datas/native/pebble
CSM_VECTOR_DIR=./csm_datas/native/vector/qdrant
CSM_KV_BACKUP_DIR=./csm_datas/backups
LUCENE_INDEX_ROOT_DIR=./csm_datas/lucene_index

# --- Bat buoc ---
JWT_SECRET=change-me-to-a-strong-secret

# --- Redis (neu dung) ---
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379

# --- Log Rust ---
RUST_LOG=info

# --- Profile overlay: dat CSM_LOCAL_PROFILE=8gb trong NSSM AppEnvironmentExtra ---
# CSM_LOCAL_PROFILE=8gb

# --- Local AI: chi khi build co --features local-ai ---
# AI_LOCAL_LLAMA_MODEL_PATH=./csm_datas/ai_local/model/model.gguf

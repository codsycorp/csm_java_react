# Overlay AI local — tắt clamp tier 8GB/weak, chỉ giới hạn bởi context window + max tokens.
#
# Bật: thêm vào config.env (hoặc export trước khi chạy server):
#   AI_LOCAL_PROMPT_BUDGET_DISABLED=true
#
# Go: run-go-server.sh tự nạp file này SAU profile (8gb/m1/strong) khi flag trên = true.
# Java: source file này sau config.local-*.env
#
# Lưu ý: không thể "vô hạn" thật — prompt/output vẫn bị ctx llama.cpp.
# Code rất dài: map-reduce tự bật (AI_LOCAL_ANALYZE_MAP_REDUCE_MIN_CODE_CHARS).
# Server 8GB: tăng ctx/max-tokens có thể OOM — giảm AI_LOCAL_LLAMA_CONTEXT_WINDOW nếu crash.

AI_LOCAL_PROMPT_BUDGET_DISABLED=true
AI_LOCAL_RUNTIME_TIER=max
AI_LOCAL_LLAMA_RUNTIME_PROFILE=max

AI_LOCAL_LLAMA_CONTEXT_WINDOW=16384
AI_LOCAL_LLAMA_CONTEXT_WINDOW_AUTO_FIT=true
AI_LOCAL_LLAMA_CONTEXT_WINDOW_HARD_CAP=32768
AI_LOCAL_LLAMA_MAX_TOKENS=4096
AI_LOCAL_LLAMA_MAX_PROMPT_CHARS=500000
AI_LOCAL_LLAMA_BATCH_SIZE=512
AI_LOCAL_LLAMA_UBATCH_SIZE=64

AI_LOCAL_PROMPT_SLOT_ACTIVE_EDITOR_CHARS=140000
AI_LOCAL_PROMPT_SLOT_RAG_CONTEXT_CHARS=50000
AI_LOCAL_PROMPT_SLOT_MEMORY_CHARS=12000
AI_LOCAL_PROMPT_SLOT_USER_REQUEST_CHARS=32000
AI_CODE_STREAM_LOCAL_PROVIDER_MAX_PROMPT_CHARS=500000
AI_CODE_STREAM_MAX_PROMPT_CHARS=520000

AI_LOCAL_RUNTIME_WEAK_PROFILE_ENABLED=false
AI_LOCAL_ANALYZE_MAP_REDUCE_MIN_CODE_CHARS=12000
AI_LOCAL_RUNTIME_WEAK_PROFILE_MAP_REDUCE_MAX_CHUNKS=12
AI_LOCAL_RUNTIME_WEAK_PROFILE_MAP_REDUCE_CHUNK_CHARS=14000

AI_SEO_ARTICLE_MAX_TOKENS=4096
AI_SEO_LOCALE_TRANSLATE_MAX_TOKENS=2048

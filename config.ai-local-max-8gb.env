# Overlay AI local cho Linux server ~8GB — chậm hơn nhưng import PDF → trigger in đầy đủ.
#
# Bật trong config.env trên server:
#   AI_LOCAL_PROMPT_BUDGET_DISABLED=true
#
# run-go-server.sh tự nạp file này (profile 8gb) thay cho config.ai-local-max.env.
# Nếu OOM / SIGABRT: giảm AI_LOCAL_LLAMA_CONTEXT_WINDOW xuống 8192 hoặc model 1.5B.

AI_LOCAL_PROMPT_BUDGET_DISABLED=true
AI_LOCAL_RUNTIME_TIER=max
AI_LOCAL_LLAMA_RUNTIME_PROFILE=max

# ctx 12288 + 3B Q4 ~2GB — cân bằng RAM vs trigger HTML dài (~4–6k output tok)
AI_LOCAL_LLAMA_CONTEXT_WINDOW=12288
AI_LOCAL_LLAMA_CONTEXT_WINDOW_AUTO_FIT=true
AI_LOCAL_LLAMA_CONTEXT_WINDOW_HARD_CAP=12288
AI_LOCAL_LLAMA_MAX_TOKENS=6144
AI_LOCAL_LLAMA_MAX_PROMPT_CHARS=48000
AI_LOCAL_LLAMA_BATCH_SIZE=512
AI_LOCAL_LLAMA_UBATCH_SIZE=32

AI_LOCAL_PROMPT_SLOT_ACTIVE_EDITOR_CHARS=32000
AI_LOCAL_PROMPT_SLOT_RAG_CONTEXT_CHARS=8000
AI_LOCAL_PROMPT_SLOT_MEMORY_CHARS=8000
AI_CODE_STREAM_LOCAL_PROVIDER_MAX_PROMPT_CHARS=48000
AI_CODE_STREAM_MAX_PROMPT_CHARS=52000

# Print trigger / code patch — output dài (return full HTML)
AI_CODE_STREAM_EDIT_MAX_TOKENS=6144
AI_CODE_STREAM_PRINT_IMPORT_MAX_TOKENS=6144

AI_LOCAL_RUNTIME_WEAK_PROFILE_ENABLED=false
AI_LOCAL_ANALYZE_MAP_REDUCE_MIN_CODE_CHARS=12000

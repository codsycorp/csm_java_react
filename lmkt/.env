# 后端 API 前缀
# Dev: prefixUrl=/api (Vite proxy) — target trỏ backend local:
# VITE_API_BASE_URL=http://localhost:15300
# Prod build: prefixUrl = VITE_API_BASE_URL (api.csmbridge.net, không suffix /api)
VITE_API_BASE_URL = "https://api.csmbridge.net"
# Socket.IO Real-time Connection URL
VITE_REALTIME_BASE_URL = "https://realtime.csmbridge.net"

# 登录之后默认调转的路由
VITE_BASE_HOME_PATH = "/home"

# VITE_BASE_URL="http://localhost:3333"
VITE_BASE_URL="https://www.csmbridge.net"
# 开启系统自动更新
VITE_APP_VERSION_MONITOR = "Y"

# 网站标题
VITE_GLOB_APP_TITLE = "Viết Phần Mềm Theo Yêu Cầu"
VITE_GLOB_APP_SHORT_NAME = "CSM"
VITE_API_TIMEOUT=20000
# SEO sync có thể >15 phút trên server yếu — 0 = không timeout phía client
# VITE_AI_TIMEOUT_MS=0
VITE_ISRUNWEB=true